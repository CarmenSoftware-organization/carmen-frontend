{
  "permissions": {
    "allow": [
      "Bash(graft ask:*)",
      "Bash(graft grep:*)",
      "Bash(graft skeleton:*)",
      "Bash(graft callers:*)",
      "Bash(graft map:*)",
      "Bash(trail ask:*)",
      "Bash(trail grep:*)",
      "Bash(trail skeleton:*)",
      "Bash(trail callers:*)",
      "Bash(trail map:*)",
      "Bash(npx graft ask:*)",
      "Bash(npx graft grep:*)",
      "Bash(npx graft skeleton:*)",
      "Bash(npx graft callers:*)",
      "Bash(npx graft map:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Write(/dev/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
