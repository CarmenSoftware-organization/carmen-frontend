{
  "openapi": "3.0.0",
  "paths": {
    "/api/ext/v1/inventory-postings": {
      "get": {
        "description": "Returns final (and stock-moving voided) GRN / CN / SR / SI / SO documents of the API key's business unit as Dr/Cr posting lines, ordered by document date, document no, doc type and id, paginated across all requested types. The business unit is taken from the API key; any `bu_code` in the query is ignored. Drafts are never exported, and a document left with no posting line (e.g. only consignment lines) is not returned. Amounts are base currency, 2-decimal strings; `balanced` is reported, never forced. Lines with `unmapped: true` carry the correct amount but need their account fixed in the GL / AP mapping in Carmen.",
        "operationId": "InventoryPostingController_list",
        "parameters": [
          {
            "name": "date_from",
            "required": true,
            "in": "query",
            "description": "Start of the range, `YYYY-MM-DD`, inclusive, in the business unit timezone. Must not be after `date_to`.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-01"
            }
          },
          {
            "name": "date_to",
            "required": true,
            "in": "query",
            "description": "End of the range, `YYYY-MM-DD`, inclusive. The range may span at most 366 days (inclusive).",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-31"
            }
          },
          {
            "name": "date_field",
            "required": false,
            "in": "query",
            "description": "Which date the range filters on: `document` = document date (default), `updated` = last update time. Use `updated` for incremental sync.",
            "schema": {
              "type": "string",
              "enum": [
                "document",
                "updated"
              ],
              "default": "document"
            }
          },
          {
            "name": "doc_types",
            "required": false,
            "in": "query",
            "description": "Comma-separated list of GRN, CN, SR, SI, SO (case-insensitive). Omit for all types.",
            "schema": {
              "type": "string",
              "example": "GRN,CN"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number, 1-based (default 1).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "perpage",
            "required": false,
            "in": "query",
            "description": "Documents per page, 1 to 200 (default 50). Larger is a 400.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "example": 50
            }
          }
        ],
